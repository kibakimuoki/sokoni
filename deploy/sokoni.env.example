# Sokoni's settings on the SERVER. Copy to /etc/sokoni/sokoni.env, replace every <...>, then:  chmod 640 /etc/sokoni/sokoni.env
# NEVER put this file on GitHub, and keep a copy of it in a password manager (without SERVER_SECRET you could not read the keys saved in the admin page).

# --- where Sokoni lives ---
PORT=3000
HOST=127.0.0.1
PUBLIC_BASE_URL=https://www.sokony.com
TRUST_PROXY=1

# --- where it keeps its data (photos, orders, users…) and its own backup copies ---
SOKONI_DATA_DIR=/var/lib/sokoni
BACKUP_DIR=/var/backups/sokoni/app

# --- passwords: make them with the command in DEPLOY.md, step 10. Two DIFFERENT long random values. ---
ADMIN_TOKEN=<24+ random characters>
SERVER_SECRET=<30+ random characters, different from ADMIN_TOKEN>
ADMIN_PATH=/ops-<random-letters-and-digits>.html

# --- your Equity account (the Pay Bill works with just these two) ---
JENGA_ACCOUNT_NUMBER=<your Equity account number>
JENGA_ACCOUNT_NAME=<the name on the account>

# Everything else (Equity API keys, NOWPayments, the AI key, SMS, e-mail…) can be pasted in Operations → Payment setup after you sign in.
