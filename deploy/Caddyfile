# Caddy is the "front door": it gets and renews the HTTPS certificate by itself and hands visitors to Sokoni (which listens only on this computer).
# Install:  cp deploy/Caddyfile /etc/caddy/Caddyfile && systemctl reload caddy
sokony.com {
	redir https://www.sokony.com{uri} permanent
}

www.sokony.com {
	encode gzip zstd
	reverse_proxy 127.0.0.1:3000
	request_body {
		max_size 15MB
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	log {
		output file /var/log/caddy/sokoni.log
	}
}
