# =====================================================================================================
#  THIS FILE IS ONLY A TEMPLATE — a menu of every setting Sokoni understands. Do not edit this one.
#  Your real settings go in a file called   sokoni.env   in your HOME folder (e.g. C:\Users\HomePC\sokoni.env),
#  or in a file called   .env   next to server.js. Copy ONLY the lines you need into it, then restart Sokoni.
#  The start-up message tells you which file it read. NEVER share your settings file. Keys pasted in chats must be revoked.
#  In Windows Notepad, save with "Save as type: All files" so the name is not  sokoni.env.txt
# =====================================================================================================
# The two lines below are PLACEHOLDERS: you MUST replace them with your own. SERVER_SECRET: 30+ random characters (keep it forever — it locks the keys you save in the admin page).
ADMIN_TOKEN=change-me-to-a-long-random-string
SERVER_SECRET=change-me-too
PUBLIC_BASE_URL=http://localhost:3000

# AI: price hints, translations, photo screening (get a key at console.anthropic.com; set a spending limit)
ANTHROPIC_API_KEY=
# Optional: pick the Claude model (default claude-sonnet-5-5). Operations → Providers → "Test AI now" shows if it works.
# ANTHROPIC_MODEL=
# Optional: only if your Anthropic account needs a workspace id header
# ANTHROPIC_WORKSPACE_ID=

# Local testing only — shows a "Test payment" method that auto-succeeds and test payouts. NEVER enable in production.
DEV_PAYMENTS=1

# Payments (enable what you have accounts for; buyers never see provider names)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
FLW_SECRET_KEY=
FLW_SECRET_HASH=
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
# M-Pesa (Kenya): see README

# Places search for towns (free account at geonames.org; without it Kenya works offline and others use a keyless fallback)
GEONAMES_USERNAME=

# Testing with the same camera/scene or several test accounts makes photos look alike. Set to -1 to switch off the cross-listing
# "looks like another listing" check while you test (default 4). Leave it at the default in production.
# PHOTO_NEAR_DUP_DISTANCE=4

# Place naming for "use my location": a contact email is polite/required by OpenStreetMap Nominatim's usage policy (or run your own: NOMINATIM_URL)
# GEOCODER_EMAIL=
# Rider dispatch: seconds a rider has to answer an offer, and search radius
# OFFER_SECONDS=60
# RIDER_MATCH_RADIUS_KM=20

# ---- going live (see PAYMENTS-SETUP.md) ----
# PUBLIC_BASE_URL must be your public https:// address (no trailing slash). Fake test payments only work while it is empty/localhost.
# MPESA_ENV=sandbox            # or production
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_SHORTCODE=             # Paybill number, or the head-office/store number for a Till
# MPESA_PASSKEY=
# MPESA_CALLBACK_BASE_URL=     # https://your-domain
# MPESA_TRANSACTION_TYPE=CustomerBuyGoodsOnline   # only for a Till (Buy Goods); leave unset for Paybill
# MPESA_TILL_NUMBER=           # the Till number (only with Buy Goods)
# MPESA_INITIATOR_NAME=        # B2C payouts
# MPESA_INITIATOR_PASSWORD=
# MPESA_CERT_PATH=
# MAX_ORDER_USD=50             # OPTIONAL cap on the size of one order. Leave this line out (the default) for NO limit.
# BACKUP_DIR=                  # default: a sokoni-backups folder next to the data folder
# BACKUP_KEEP=30

# ---- international bank transfer (wire / ACH). Easier: enter these in Operations -> Payment setup ----
# WIRE_ACCOUNT_NAME=
# WIRE_BANK_NAME=
# WIRE_ACCOUNT_NUMBER=         # account number or IBAN
# WIRE_SWIFT=                  # and/or WIRE_ROUTING (US ACH)
# WIRE_CURRENCIES=USD          # currencies the account can receive; other order currencies are converted to the first
# WIRE_WEBHOOK_SECRET=         # optional: lets an automation confirm arrivals via /api/webhooks/wire
# WIRE_TOLERANCE_PERCENT=2
# WIRE_EXPIRY_DAYS=7

# ---- PayPal (buyers in the USA, Europe, Brazil…) — or enter these in Operations → Payment setup ----
# PAYPAL_ENV=sandbox            # or live
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_WEBHOOK_ID=            # optional but recommended: lets the app verify PayPal's webhook signatures too
# Currency buffer (%) added when a buyer is charged in a different currency from the listing (default 2). Keep above 0.
# FX_MARGIN_PERCENT=2

# ---- countries ----
# Comma-separated country codes where buyers get "Mobile money" through Flutterwave (default: KE UG TZ RW GH ZM MW SL SN CI BJ BF ML TG NE GN CM GA CG CD)
# MOBILE_MONEY_COUNTRIES=
# Cuba, Iran, North Korea and Syria are blocked by default (providers refuse them). Add more here:
# BLOCKED_COUNTRIES=
# Only on legal advice: SANCTIONS_DEFAULTS=off

# ---- Sign-in codes switch ON BY THEMSELVES once an SMS provider AND an email provider are connected and each has passed a "Send a test" (Operations → Payment setup).
# Before that: phone + email + password only, and phones/emails are NOT verified. Leave this unset normally. 1 = force ON (local testing with DEV_OTP); 0 = force OFF.
# VERIFY_CODES=
# The providers below are only needed when codes are on (email is also used for receipts). Or enter them in Operations → Payment setup.
# SMS: Africa's Talking (Kenya/Africa) or Twilio (global)
# SMS_PROVIDER=africastalking        # or twilio
# AT_USERNAME=
# AT_API_KEY=
# AT_SENDER_ID=                      # optional, needs approval
# AT_SANDBOX=0                       # 1 = testing only, no real SMS
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=                       # your Twilio number or sender ID
# Email: Resend or SendGrid — the sender must be on a domain you verified with them
# EMAIL_PROVIDER=resend              # or sendgrid
# RESEND_API_KEY=
# SENDGRID_API_KEY=
# EMAIL_FROM=Sokoni <no-reply@your-domain.example>
# Local testing ONLY: show the codes on screen / in the log. Ignored on a public PUBLIC_BASE_URL.
# DEV_OTP=1
# Limits (defaults shown): seconds before a code can be re-sent, and sign-ups allowed per connection per hour
# OTP_RESEND_GAP_SECONDS=30
# SIGNUP_PER_HOUR=60

# ---- payment policy: M-Pesa Paybill + USDC ----
# Largest single M-Pesa payment (KES). Above this, buyers are asked to pay with USDC. Check your Paybill's real limit with Safaricom.
# MPESA_MAX_KES=250000
# C2B registration API version for "pay from the M-Pesa menu" (v2 default; v1 if v2 isn't enabled for you)
# MPESA_C2B_VERSION=v2
# Pin the crypto coin (optional) — a NOWPayments code, e.g. from their dashboard. Otherwise choose USDC networks in the dashboard.
# CRYPTO_PAY_CURRENCY=
# ---- Sokoni Coin (an in-app reward, not a blockchain token) ----
# COIN_EARN_PER_USD=0.5          # coins each side earns per US$1 of a completed trade
# COIN_USD_VALUE=0.01            # US$ value of one coin when it lowers a seller's fee
# COIN_MAX_COMMISSION_SHARE=0.5  # coins can cover at most this share of the commission on a payout

# ---- Bank alerts → automatic confirmation of bank transfers (OFF by default) ----
# Forward your bank's "money received" SMS/emails to the secret address shown in Operations → Payments → Bank transfers.
# SMS can be forged, so keep the limit low. Amounts above BANK_AUTO_MAX are left for a person.
# BANK_AUTO_CONFIRM=1
# BANK_AUTO_MAX=50000

# ---- Paystack (Kenya) — M-Pesa / Airtel Money PIN prompts, money held in your Paystack balance, automatic payouts. Full guide: PAYSTACK 4k in PAYMENTS-SETUP.md ----
#   • easiest: Operations → Payment setup → Paystack (the secret key is stored ENCRYPTED there)
#   • or set them here:
# PAYSTACK_SECRET_KEY=               # sk_test_… (testing) or sk_live_… (real money)
# PAYMENT_SHOW=                     # who buyers see: paystack = Paystack's options plus crypto (the default while Paystack is connected; Equity appears once its codes are entered), all = everything that is connected
# PAYOUT_WAIT_DAYS=                  # how many days sellers, riders and buyers are TOLD a payout takes (empty = 2 while Paystack is connected; 0 = instant)
# PAYSTACK_PAYOUTS=                  # automatic M-Pesa payouts: on by themselves with a test key; with a LIVE key leave OFF until you set 1 (after one small real payout)
# PAYSTACK_PASS_FEE=mobile            # who pays Paystack's fee: mobile = the buyer pays it on M-Pesa/Airtel Money (default), all = on cards too, off = you pay it
# PAYSTACK_FEE_MOBILE_PCT=1.5        # Paystack's rate for mobile money (change if your rate changes)
# PAYSTACK_FEE_CARD_PCT=2.9          # the rate used for cards when PAYSTACK_PASS_FEE=all
# PAYOUT_FUNDS_WAIT_HOURS=168       # how long a payout keeps retrying while the buyer's payment settles into your balance (7 days)
# PAYMENT_CHECK_EVERY_MS=8000        # while a buyer is waiting on an order, how often their payment may be checked with the provider
# PAYSTACK_MPESA_MAX=150000          # one M-Pesa payment (Safaricom's limit)
# PAYSTACK_MOBILE_MIN=10             # one payout to an M-Pesa wallet, in KES
# PAYSTACK_MOBILE_MAX=250000
# MPESA_PROVIDER=paystack            # which provider sends the M-Pesa prompt when several are connected (default order: paystack, jenga, fincra, daraja, flutterwave)

# ---- Fincra (Kenya) — M-Pesa / Airtel Money / Equitel PIN prompts and M-Pesa payouts. Full guide: PAYMENTS-SETUP.md 4j ----
#   • easiest: Operations → Payment setup → Fincra (Business ID, secret API key, webhook secret are stored ENCRYPTED there)
#   • or set them here:
# FINCRA_ENV=sandbox                 # sandbox = testing only; live = real money
# FINCRA_BUSINESS_ID=
# FINCRA_API_KEY=
# FINCRA_WEBHOOK_SECRET=
# FINCRA_PAYOUTS=                    # automatic M-Pesa payouts: on by themselves in the sandbox; with real money leave OFF until you set 1 (after one small real payout)
# FINCRA_SENDER_NAME=                # only if Fincra's sandbox asks for a sender on local payouts
# FINCRA_MOBILE_MIN=10               # assumed payout limits in KES — change when Fincra confirms its real ones
# FINCRA_MOBILE_MAX=250000
# PROMPT_NETWORKS=mpesa,airtel,equitel   # which networks get a PIN prompt (default: mpesa only)

# ---- Equity Bank (Jenga) — your business account. Full guide: PAYMENTS-SETUP.md 4f–4g ----
# WHERE THINGS GO:
#   • account number + business name  → here (the two lines below) — the account number is what unlocks everything else
#   • merchant code, consumer secret, API key → Operations → Payment setup → Equity Bank (Jenga)  (stored ENCRYPTED; better than typing them here)
#   • the signing key → Operations → Payment setup → "Generate signing keys", then upload the PUBLIC key in the Jenga console
# JENGA_ENV=sandbox                 # practice mode; change to production when Equity gives you LIVE credentials
# JENGA_ACCOUNT_NUMBER=             # your Equity business account number
# JENGA_ACCOUNT_NAME=               # your registered business name, exactly as Equity has it (shown to buyers paying by bank transfer)
# JENGA_PAYOUTS=                    # payouts are AUTOMATIC in production. 0 = stop them; 1 = try them in the sandbox. Equity's minimum is KES 100 per payout — test live with KES 100.
# JENGA_PESALINK_MAX=999999         # largest single payout to a bank account
# JENGA_FLOAT_BUFFER=0              # keep this many shillings untouched in the account
# EQUITY_PAYBILL=247247             # the Pay Bill number buyers use from the M-Pesa menu (Equity's shared one)
# MPESA_PROVIDER=jenga              # who sends the M-Pesa prompt: jenga (Equity) / daraja (your own Safaricom Paybill) / flutterwave
# --- only if you really want to keep them in this file instead of the admin page (not recommended): ---
# JENGA_MERCHANT_CODE=
# JENGA_CONSUMER_SECRET=
# JENGA_API_KEY=
# JENGA_PRIVATE_KEY=                # use "Generate signing keys" in the admin screen instead of typing this

# ---- Android app (Play Store version of this website) — see APP.md, Stage 2 ----
# ANDROID_PACKAGE=africa.sokoni.app
# ANDROID_SHA256=AA:BB:CC:...        # signing-certificate fingerprint(s) from Play Console, comma-separated

# ---- Crypto (see PAYMENTS-SETUP.md 4h) ----
# NOWPAYMENTS_SANDBOX=1            # practise with a sandbox key — no real coins
# CRYPTO_MIN_USD=2
# CRYPTO_SHORT_TOLERANCE_USD=1
# CRYPTO_SHORT_TOLERANCE_PCT=2

# ---- Delivery pricing, who pays, and what Sokoni keeps (see PRICING.md) ----
# PLATFORM_COMMISSION_PERCENT=7     # gross; ≈5% NET after typical provider, payout and coin costs
# NET_TARGET_PERCENT=5
# DELIVERY_SELLER_SHARE_PCT=30      # the seller covers this share of the delivery fee…
# DELIVERY_SELLER_CAP_PCT=10        # …but never more than this % of the value of what they sell
# RIDER_CUT_PCT=0                   # Sokoni's cut of the rider's fee
# DELIVERY_RATE_MULT=1              # scales every delivery price (1.2 = 20% dearer)
# COST_PCT_MPESA=1.5                # ASSUMED provider costs — replace with your real fee schedules
# COST_PCT_CRYPTO=1.0
# COST_PCT_BANK=0.2
# COST_PCT_CARD=3.5
# COST_FIXED_PAYOUT_USD=0.20
# ---- Keeping the admin console private (see README) ----
# ADMIN_PATH=/ops-<make-your-own-random-name>.html   # moves the admin page; /admin.html then says "Not found"
# ADMIN_ALLOWED_IPS=                                  # comma-separated addresses allowed to reach the admin page and admin API
# TRUST_PROXY=1                                       # behind Caddy / nginx. Use  cloudflare  only behind Cloudflare and nothing else
# HOST=127.0.0.1                                      # listen only on this computer (when a web server sits in front)
# ---- Mobile-money networks (Operations -> Payment setup -> Equity). What each network can do depends on what Equity has confirmed for YOUR merchant account. ----
# PAYBILL_NETWORKS=mpesa,airtel,equitel      # who can pay Equity's Pay Bill 247247 by hand. Add tkash only after Equity confirms it.
# PROMPT_NETWORKS=mpesa                      # who can get a PIN prompt through Equity. Add equitel once Finserve authorises it; airtel / tkash only if Finserve confirms a prompt exists.
# ---- Ratings and analytics ----
# RATING_REMIND_EVERY_DAYS=2        # buyers who haven't rated a received order are reminded this often...
# RATING_REMIND_MAX=5               # ...at most this many times per order (they can also tap "Not now")
# RATING_REMIND_WINDOW_DAYS=14      # ...and only for orders received within this many days
# RATING_EDIT_DAYS=7                # a buyer can change their rating for this long
# ANALYTICS_SYNC_MINUTES=10         # how often the permanent analytics record is rebuilt
# ---- Push notifications ----
# PUSH_SUBJECT=mailto:you@your-domain   # who the push services can contact (defaults to your https PUBLIC_BASE_URL)
# ---- Sokoni Coin as trust collateral (see COIN.md) ----
# COIN_LEVY_PCT=0.05                # each side pays this % of the goods value as a coin levy (real money)
# COIN_LEVY_CHARGED=1               # 0 = charge nothing extra; coins are then only recorded
# COIN_SOKONI_SHARE=0.5             # Sokoni's share of that pool; the rest is shared by buyer and seller
# BOND_MIN_COINS=100
# BOND_COOLDOWN_DAYS=14
# BOND_SLASH_SHARE=0.5
# BOOST_COINS_PER_DAY=20
# ---- Continue with Google / Facebook (optional; you can also paste these in Operations → Payment setup → Google and Facebook sign-in) ----
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
# FACEBOOK_GRAPH_VERSION=v21.0      # only change if Facebook retires this version
# SOCIAL_TIKTOK_URL=https://www.tiktok.com/@sokoni91
# SOCIAL_FACEBOOK_URL=https://www.facebook.com/share/1Hx8qRELJC/
